POSTGRES_USER=travel_buddy_dev
POSTGRES_PASSWORD=local_dev_only
POSTGRES_DB=travel_buddy

# Opcjonalne limity lokalne (restart backendu zeruje liczniki w pamięci):
# AUTH_RATE_LOGIN_IP=10
# AUTH_RATE_LOGIN_ACCOUNT=10
# AUTH_RATE_REGISTER_IP=5
# AUTH_RATE_RESET_IP=10
# AUTH_RATE_RESET_ACCOUNT=3

# Google OIDC — opcjonalne. Bez konfiguracji logowanie hasłem nadal działa.
GOOGLE_OIDC_ENABLED=false
# GOOGLE_OIDC_CLIENT_ID=
# GOOGLE_OIDC_CLIENT_SECRET=
GOOGLE_OIDC_REDIRECT_URI=http://localhost:3000/api/v1/auth/google/callback
